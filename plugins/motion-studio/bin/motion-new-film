#!/usr/bin/env node
// motion-new-film: cria films/<id>/ a partir do kit do plugin (timeline,
// film, cenas de exemplo, libs, trilha, renderer, testes de ritmo), mais
// assets/<id>/, out/<id>/ e o production.json do filme.
//
//   motion-new-film <id> --titulo "Nome do filme" [--narrado] [--estudio <dir>]
import fs from 'node:fs'
import { createRequire } from 'node:module'
import path from 'node:path'
import { fileURLToPath, pathToFileURL } from 'node:url'

const PLUGIN = path.join(path.dirname(fileURLToPath(import.meta.url)), '..')
const KIT = path.join(PLUGIN, 'kit')
const E = await import(pathToFileURL(path.join(PLUGIN, 'scripts', 'lib', 'state.mjs')).href)
const TEXTO = new Set(['.js', '.mjs', '.html', '.md', '.json'])

function parse(argv) {
  const out = { pos: [], narrado: undefined }
  for (let i = 0; i < argv.length; i++) {
    if (argv[i] === '--narrado') out.narrado = true
    else if (argv[i] === '--titulo') out.titulo = argv[++i]
    else if (argv[i] === '--estudio') out.estudio = argv[++i]
    else out.pos.push(argv[i])
  }
  return out
}

/** Copia `de` sobre `para`, trocando os marcadores nos arquivos de texto. */
function copiar(de, para, trocas) {
  for (const item of fs.readdirSync(de, { withFileTypes: true })) {
    const origem = path.join(de, item.name)
    const destino = path.join(para, item.name)
    if (item.isDirectory()) {
      fs.mkdirSync(destino, { recursive: true })
      copiar(origem, destino, trocas)
    } else if (TEXTO.has(path.extname(item.name))) {
      let s = fs.readFileSync(origem, 'utf8')
      for (const [k, v] of Object.entries(trocas)) s = s.replaceAll(k, v)
      fs.writeFileSync(destino, s)
    } else {
      fs.copyFileSync(origem, destino)
    }
  }
}

function main() {
  const { pos, titulo: tituloArg, narrado: narradoArg, estudio: dirArg } = parse(process.argv.slice(2))
  const id = pos[0]
  if (!id) {
    console.log('uso: motion-new-film <id> --titulo "Nome do filme" [--narrado] [--estudio <dir>]')
    return 1
  }
  if (!E.ID_VALIDO.test(id)) throw new E.ErroProducao(`id inválido "${id}": use minúsculas, números e hífen`)
  const estudio = path.resolve(dirArg ?? process.env.MOTION_STUDIO_DIR ?? E.acharEstudio(process.cwd()) ?? '')
  if (!fs.existsSync(path.join(estudio, 'films'))) throw new E.ErroProducao(`${estudio} não tem films/: rode de dentro do estúdio ou passe --estudio`)
  const destino = path.join(estudio, 'films', id)
  // A pasta pode já existir só com o production.json do briefing: o código entra depois dele.
  const existente = fs.existsSync(E.caminhoProducao(estudio, id)) ? E.lerProducao(estudio, id) : null
  if (fs.existsSync(path.join(destino, 'film.js'))) throw new E.ErroProducao(`films/${id} já tem código; escolha outro id (o estúdio é compartilhado por vários filmes)`)
  if (existente && narradoArg !== undefined && existente.narrado !== narradoArg) {
    throw new E.ErroProducao(`o briefing de ${id} diz ${existente.narrado ? 'narrado' : 'sem narração'}; tire --narrado ou corrija a decisão "narracao"`)
  }
  const narrado = existente ? existente.narrado : Boolean(narradoArg)

  // O estúdio precisa do playwright (renderer) e de films/ como ESM (timeline.js é lido pelo node e pelo navegador).
  const avisos = []
  try {
    createRequire(path.join(estudio, 'package.json')).resolve('playwright')
  } catch {
    avisos.push('playwright não está instalado no estúdio: rode `npm i -D playwright && npx playwright install chromium` na raiz')
  }
  const pkg = path.join(estudio, 'films', 'package.json')
  if (!fs.existsSync(pkg)) fs.writeFileSync(pkg, '{\n  "type": "module"\n}\n')
  else if (JSON.parse(fs.readFileSync(pkg, 'utf8')).type !== 'module') avisos.push('films/package.json não tem "type": "module"; o kit é ESM')

  const hoje = new Date().toISOString().slice(0, 10)
  const titulo = existente?.titulo ?? tituloArg ?? id
  const trocas = { __FILME__: id, __TITULO__: titulo, __DATA__: hoje }
  fs.mkdirSync(destino, { recursive: true })
  copiar(path.join(KIT, 'base'), destino, trocas)
  if (narrado) copiar(path.join(KIT, 'narrated'), destino, trocas)
  fs.mkdirSync(path.join(estudio, 'assets', id), { recursive: true })
  fs.mkdirSync(path.join(estudio, 'out', id), { recursive: true })

  if (!existente) E.salvarProducao(estudio, E.criarProducao({ id, titulo, narrado, em: hoje }))

  console.log(`criado films/${id}/ (${narrado ? 'narrado' : 'sem narração'}), assets/${id}/ e out/${id}/; production.json ${existente ? 'mantido' : 'criado'}`)
  for (const a of avisos) console.log(`aviso: ${a}`)
  console.log(`próximo passo: motion-production status ${id}`)
  return 0
}

try {
  process.exitCode = main()
} catch (error) {
  if (error instanceof E.ErroProducao) {
    console.error(`motion-new-film: ${error.message}`)
    process.exitCode = 1
  } else {
    throw error
  }
}
